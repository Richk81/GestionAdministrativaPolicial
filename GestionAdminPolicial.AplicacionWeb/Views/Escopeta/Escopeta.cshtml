
@{
    ViewData["Title"] = "Escopeta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <!-- ============================================================
    =ESTILOS PARA ESTA PAGINA (css)
    ===============================================================-->
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
}


<!-- DataTales Example -->
<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-white">
            <i class="fas fa-bullseye fa-lg mr-2"></i> Lista de Escopetas
        </h6>


        <div class="d-flex gap-2">
            <!-- Botón Nueva Escopeta -->
            <button class="btn btn-success btn-sm d-flex align-items-center shadow-sm" id="btnNuevaEscopeta">
                <i class="fas fa-user-plus me-2"></i> Nueva Escopeta
            </button>

            <!-- Botón Escopetas Eliminados -->
            <button class="btn btn-danger btn-sm d-flex align-items-center shadow-sm" id="btnEscopetasEliminadas">
                <i class="fas fa-trash me-2"></i> Escopetas Eliminadas
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="tbdataEscopeta" cellspacing="0" style="width:100%">
                <thead>
                    <tr>
                        <th>N°</th> <!-- Enumeración -->
                        <th>N° de Serie</th>
                        <th>Marca y Modelo</th>
                        <th>Estado</th>
                        <th>Observaciones</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h6>Detalle de la Escopeta a Registrar</h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>

            <div class="modal-body">
                <form id="formEscopeta">
                    <input type="hidden" id="txtIdEscopeta" value="0">

                    <div class="form-row">
                        <div class="form-group col-sm-6">
                            <label for="txtSerie">N° de Serie</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtSerie" name="N° de Serie">
                        </div>
                        <div class="form-group col-sm-6">
                            <label for="txtMarcaYModelo">Marca y Modelo</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtMarcaYModelo" name="Marca y Modelo">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-sm-6">
                            <label for="cboEstado">Estado</label>
                            <select class="form-control form-control-sm input-validar" id="cboEstado" name="Estado Escopeta">
                                <option value="">-- Seleccione --</option>
                                <option value="Operativo">Operativa</option>
                                <option value="Fuera de Servicio">Fuera de Servicio</option>
                                <option value="En Reparacion">En Reparacion</option>
                                <option value="Extraviada">Extraviada</option>
                                <option value="Secuestrada">Secuestrada</option>
                                <option value="Comisionado">Comisionada</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-sm-12">
                            <label for="txtObservaciones">Observaciones</label>
                            <textarea class="form-control form-control-sm" id="txtObservaciones" name="Observaciones" rows="4"></textarea>
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm" id="btnGuardarEscopeta">Guardar</button>
                <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">Cancelar</button>
            </div>

        </div>
    </div>
</div>

<!-- Modal ESCOPETAS EliminadAs -->
<div class="modal fade" id="modalEscopetasEliminadas" tabindex="-1" aria-labelledby="tituloEscopetasEliminadas" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title" id="tituloEscopetasEliminadas">
                    Escopetas Eliminadas
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="tbEscopetasEliminadas" style="width:100%">
                        <thead>
                            <tr>
                                <th>N°</th>
                                <th>N° de Serie</th>
                                <th>Marca y Modelo</th>
                                <th>Estado</th>
                                <th>Observaciones</th>
                                <th>Fecha Eliminado</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!-- ============================================================
    =SCRIPTS PARA ESTA PAGINA
    ===============================================================-->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>

    <script src="~/vendor/datatables/extensiones/js/pdfmake.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/vfs_fonts.js"></script>

    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>

    <!-- SweetAlert -->
    <script src="~/vendor/sweetalert/sweetalert.min.js"></script>

    <!-- JAVA SCRIPT -->
    <script src="~/js/vistas/Escopeta_Index.js"></script>
}

