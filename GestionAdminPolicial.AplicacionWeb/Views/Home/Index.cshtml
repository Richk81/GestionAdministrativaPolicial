@{
    ViewData["Title"] = "Home Page";
}

<style>
    .title-modern {
        font-family: 'Segoe UI', sans-serif;
        font-weight: 800;
        background: linear-gradient(90deg, #0d3b4a, #116b85);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .subtitle-modern {
        font-family: 'Segoe UI', sans-serif;
        font-size: 1.1rem;
        color: #2c4e57;
    }

    .card-modern {
        background: #b4daec;
        border-radius: 12px;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .card-modern:hover {
            transform: translateY(-6px);
            box-shadow: 0 8px 18px rgba(0,0,0,0.15);
        }
</style>

<!-- Fondo Blanco -->
<div class="py-1" style="background: #ffffff; min-height: 80vh; color:#0d3b4a;">

    <div class="container text-center">

        <h1 class="display-5 title-modern animate__animated animate__fadeInDown animate__delay-1s">
            Sistema: "Gestión Administrativa Policial"
        </h1>

        <img src="~/img/GIF_Saludo1.gif" alt="Logo Policial"
             style="width: 109px; height: auto;"
             class="mb-4 animate__animated animate__fadeInDown">

        <p class="subtitle-modern mt-3 animate__animated animate__fadeInDown animate__delay-2s">
            Tecnicatura Superior en Desarrollo de Software ---> <strong>Proyecto Final</strong>
        </p>

        <p class="subtitle-modern animate__animated animate__fadeInDown animate__delay-3s">
            Desarrollado por <strong>Juan José "Richard" Arroyo</strong> - Año 2025
        </p>
    </div>

    <div class="container mt-5">

        <!-- FILA 1: 3 tarjetas -->
        <div class="row justify-content-center">

            <!-- Personal Policial -->
            <div class="col-md-3 mb-4">
                <div class="card card-modern border-0 shadow-lg h-100 text-center animate__animated animate__fadeInUp animate__delay-1s">
                    <div class="card-body">
                        <i class="fas fa-user-shield fa-3x text-primary mb-3"></i>
                        <h5 class="fw-bold">Personal Policial</h5>
                        <p class="small" style="color:#26363d;">Registro, traslado y gestión de datos del personal.</p>
                    </div>
                </div>
            </div>

            <!-- Chalecos -->
            <div class="col-md-3 mb-4">
                <div class="card card-modern border-0 shadow-lg h-100 text-center animate__animated animate__fadeInUp animate__delay-2s">
                    <div class="card-body">
                        <i class="fas fa-vest-patches fa-3x text-success mb-3"></i>
                        <h5 class="fw-bold">Chalecos</h5>
                        <p class="small" style="color:#26363d;">Control de chalecos, asignaciones, estado y vencimiento.</p>
                    </div>
                </div>
            </div>

            <!-- Escopetas / Armas -->
            <div class="col-md-3 mb-4">
                <div class="card card-modern border-0 shadow-lg h-100 text-center animate__animated animate__fadeInUp animate__delay-3s">
                    <div class="card-body">
                        <i class="fas fa-crosshairs fa-3x text-danger mb-3"></i>
                        <h5 class="fw-bold">Escopetas</h5>
                        <p class="small" style="color:#26363d;">Gestión de armas y control de estado.</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- FILA 2: 2 tarjetas -->
        <div class="row justify-content-center">

            <!-- Vehículos -->
            <div class="col-md-3 mb-4">
                <div class="card card-modern border-0 shadow-lg h-100 text-center animate__animated animate__fadeInUp animate__delay-4s">
                    <div class="card-body">
                        <i class="fas fa-car-side fa-3x text-warning mb-3"></i>
                        <h5 class="fw-bold">Vehículos</h5>
                        <p class="small" style="color:#26363d;">Administración de unidades móviles y reparaciones.</p>
                    </div>
                </div>
            </div>

            <!-- Radios -->
            <div class="col-md-3 mb-4">
                <div class="card card-modern border-0 shadow-lg h-100 text-center animate__animated animate__fadeInUp animate__delay-5s">
                    <div class="card-body">
                        <i class="fas fa-broadcast-tower fa-3x text-info mb-3"></i>
                        <h5 class="fw-bold">Radios</h5>
                        <p class="small" style="color:#26363d;">Gestión y control de equipos de comunicación.</p>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- Frase institucional -->
    <div class="text-center mt-5 animate__animated animate__fadeInUp animate__delay-6s" style="color:#0d3b4a;">
        <hr class="my-4" style="width: 60%; border-color: rgba(13,59,74,0.3);">
        <h6 class="fst-italic">
            “Comprometidos con la transparencia, la seguridad y la eficiencia institucional.”
        </h6>
    </div>

</div>



