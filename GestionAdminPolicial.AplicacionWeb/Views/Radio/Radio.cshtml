
@{
    ViewData["Title"] = "Radio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <!-- ============================================================
    =ESTILOS PARA ESTA PAGINA (css)
    ===============================================================-->
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
}


<!-- DataTales Example -->
<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-white">
            <i class="fas fa-broadcast-tower fa-2x mr-2"></i> Lista de Radios
        </h6>


        <div class="d-flex gap-2">
            <!-- Botón Nueva RADIO -->
            <button class="btn btn-success btn-sm d-flex align-items-center shadow-sm" id="btnNuevaRadio">
                <i class="fas fa-user-plus me-2"></i> Nueva Radio
            </button>

            <!-- Botón RADIOS EliminadAs -->
            <button class="btn btn-danger btn-sm d-flex align-items-center shadow-sm" id="btnRadiosEliminadas">
                <i class="fas fa-trash me-2"></i> Radios Eliminadas
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="tbdataRadios" cellspacing="0" style="width:100%">
                <thead>
                    <tr>
                        <th>N°</th> <!-- Enumeración -->
                        <th>N° de Serie</th>
                        <th>Marca y Modelo</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Observaciones</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h6>Detalle de la Radio a Registrar</h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>

            <div class="modal-body">
                <form id="formRadio">
                    <input type="hidden" id="txtIdRadio" value="0">

                    <div class="form-row">
                        <div class="form-group col-sm-6">
                            <label for="txtSerieRadio">N° de Serie de Radio</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtSerieRadio" name="N° de Serie">
                        </div>
                        <div class="form-group col-sm-6">
                            <label for="txtMarcaYModelo">Marca y Modelo</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtMarcaYModelo" name="Marca y Modelo">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-sm-6">
                            <label for="cboTipo">Tipo de Radio</label>
                            <select class="form-control form-control-sm input-validar" id="cboTipo" name="Tipo de Radio">
                                <option value="">-- Seleccione --</option>
                                <option value="Radio Base">Radio Base</option>
                                <option value="H.T">H.T</option>
                            </select>
                        </div>
                        <div class="form-group col-sm-6">
                            <label for="cboEstado">Estado</label>
                            <select class="form-control form-control-sm input-validar" id="cboEstado" name="Estado">
                                <option value="">-- Seleccione --</option>
                                <option value="Operativa">Operativa</option>
                                <option value="Fuera de Servicio">Fuera de Servicio</option>
                                <option value="En Reparacion">En Reparacion</option>
                                <option value="Extraviada">Extraviada</option>
                                <option value="Secuestrada">Secuestrada</option>
                                <option value="Comisionado">Comisionado</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-sm-12">
                            <label for="txtObservaciones">Observaciones</label>
                            <textarea class="form-control form-control-sm" id="txtObservaciones" name="Observaciones" rows="4"></textarea>
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm" id="btnGuardarRadio">Guardar</button>
                <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">Cancelar</button>
            </div>

        </div>
    </div>
</div>

<!-- Modal RADIOS Eliminadas -->
<div class="modal fade" id="modalRadiosEliminadas" tabindex="-1" aria-labelledby="tituloRadiosEliminadas" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title" id="tituloRadiosEliminadas">
                    Radios Eliminadas
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="tbRadiosEliminadas" style="width:100%">
                        <thead>
                            <tr>
                                <th>N°</th>
                                <th>N° de Serie</th>
                                <th>Marca y Modelo</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th>Observaciones</th>
                                <th>Fecha Eliminado</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- ============================================================
    =SCRIPTS PARA ESTA PAGINA
    ===============================================================-->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>

    <script src="~/vendor/datatables/extensiones/js/pdfmake.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/vfs_fonts.js"></script>

    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>

    <!-- SweetAlert -->
    <script src="~/vendor/sweetalert/sweetalert.min.js"></script>

    <!-- JAVA SCRIPT -->
    <script src="~/js/vistas/Radio_Index.js"></script>
}

